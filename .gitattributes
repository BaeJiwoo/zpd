* text=auto
*.cs text eol=lf
*.cpp text eol=lf
*.hpp text eol=lf
*.proto text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ps1 text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
# Unity serializes empty YAML values with a trailing space and may end with a blank line.
*.meta text eol=lf whitespace=-blank-at-eol,-blank-at-eof
*.unity text eol=lf whitespace=-blank-at-eol,-blank-at-eof
*.prefab text eol=lf
*.png binary
*.jpg binary
*.otf binary
*.ttf binary
*.dll binary
*.docx binary
